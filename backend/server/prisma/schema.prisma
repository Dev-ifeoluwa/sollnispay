generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionType {
  AIRTIME
  DATA
  TV_SUBSCRIPTION
  ELECTRICITY
  EDUCATION
  SPORT
  WALLET_FUNDING
  TRANSFER_SENT
  TRANSFER_RECEIVED
  TRANSFER_BANK
}

enum Provider {
  VTPASS
  INTERNAL
  PAYSTACK
  CLUBKONNECT
  SABUSS
}

enum OtpPurpose {
  PASSWORD
  PIN
}

model TotalUser {
  id                   Int                 @id @default(autoincrement())
  email                String              @unique
  password             String
  firstName            String
  lastName             String
  phoneNumber          String
  transactionPin       String?
  balance              Float               @default(0)
  transactions         Transaction[]
  wallet               Wallet?

  monnifyAccountRef    String?
  monnifyAccountNumber String?
  monnifyAccountStatus String?

  paystackCustomerCode      String?
  paystackAccountNumber     String?   @unique
  paystackBankName          String?
  paystackAccountName       String?
  paystackAccountStatus     String?
  paystackAssignRequestedAt DateTime?

  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  passwordChangedAt DateTime?
  passwordResets    PasswordReset[]

  deletedAt            DateTime?           // NEW: set when the user deletes their account

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  conversions          ConversionHistory[]
}

model Wallet {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      TotalUser @relation(fields: [userId], references: [id])
  currency  String    @default("NGN")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Transaction {
  id             Int               @id @default(autoincrement())
  amount         Float
  type           TransactionType
  provider       Provider?
  providerRef    String?
  idempotencyKey String?           @unique
  status         TransactionStatus @default(PENDING)
  meta           Json?
  description    String?
  itemsPurchased String?
  dayPurchased   DateTime?
  itemsTime      DateTime?
  proofUrl       String?

  approvedById   Int?
  createdAt      DateTime          @default(now())

  userId Int
  user   TotalUser @relation(fields: [userId], references: [id], onDelete: Restrict) // CHANGED: was Cascade

  approvedBy Admin? @relation(fields: [approvedById], references: [id])

  @@index([providerRef])
}

model Service {
  id        String   @id @default(cuid())
  name      String
  type      String
  code      String
  price     Float
  provider  Provider
  isActive  Boolean  @default(true)
  network   String?
  validity  String?
  costPrice Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, code])
}

model ConversionHistory {
  id              Int       @id @default(autoincrement())
  userId          Int
  fromCurrency    String
  toCurrency      String
  amount          Float
  rate            Float
  convertedAmount Float
  timestamp       DateTime  @default(now())
  user            TotalUser @relation(fields: [userId], references: [id])
}

model Admin {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String
  firstName   String
  middleName  String
  lastName    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Transaction Transaction[]
}


model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      TotalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  purpose OtpPurpose @default(PASSWORD)

  @@index([userId, createdAt])
}