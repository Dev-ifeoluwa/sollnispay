generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== ENUMS ==========

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionType {
  AIRTIME
  DATA
  TV_SUBSCRIPTION
  ELECTRICITY
  EDUCATION
  SPORT
  WALLET_FUNDING
  TRANSFER_SENT
  TRANSFER_RECEIVED
  TRANSFER_BANK
  CARD_FUNDING
  CARD_WITHDRAWAL
}

enum Provider {
  VTPASS
  INTERNAL
  PAYSTACK
  CLUBKONNECT
  SABUSS
  YANGAPLUG
}

enum OtpPurpose {
  PASSWORD
  PIN
}

model TotalUser {
  id                   Int                 @id @default(autoincrement())
  email                String              @unique
  password             String
  firstName            String
  lastName             String
  phoneNumber          String
  transactionPin       String?
  balance              Float               @default(0)
  transactions         Transaction[]
  wallet               Wallet?

  monnifyAccountRef    String?
  monnifyAccountNumber String?
  monnifyAccountStatus String?

  paystackCustomerCode      String?
  paystackAccountNumber     String?   @unique
  paystackBankName          String?
  paystackAccountName       String?
  paystackAccountStatus     String?
  paystackAssignRequestedAt DateTime?

  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  passwordChangedAt DateTime?
  passwordResets    PasswordReset[]

  deletedAt            DateTime?

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  conversions          ConversionHistory[]

  // Sollnis Card (Yangaplug virtual cards)
  cardholder           Cardholder?
  cards                Card[]
}

model Wallet {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      TotalUser @relation(fields: [userId], references: [id])
  currency  String    @default("NGN")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Transaction {
  id             Int               @id @default(autoincrement())
  amount         Float
  type           TransactionType
  provider       Provider?
  providerRef    String?
  idempotencyKey String?           @unique
  status         TransactionStatus @default(PENDING)
  meta           Json?
  description    String?
  itemsPurchased String?
  dayPurchased   DateTime?
  itemsTime      DateTime?
  proofUrl       String?

  approvedById   Int?
  createdAt      DateTime          @default(now())

  userId Int
  user   TotalUser @relation(fields: [userId], references: [id], onDelete: Restrict)

  approvedBy Admin? @relation(fields: [approvedById], references: [id])

  @@index([providerRef])
}

model Service {
  id        String   @id @default(cuid())
  name      String
  type      String
  code      String
  price     Float
  provider  Provider
  isActive  Boolean  @default(true)
  network   String?
  validity  String?
  costPrice Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, code])
}

model Cardholder {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  user        TotalUser @relation(fields: [userId], references: [id])
  yangaplugId String    @unique
  status      String
  createdAt   DateTime  @default(now())
  cards       Card[]
}

model Card {
  id           Int        @id @default(autoincrement())
  userId       Int
  user         TotalUser  @relation(fields: [userId], references: [id])
  cardholderId Int
  cardholder   Cardholder @relation(fields: [cardholderId], references: [id])
  yangaplugId  String?    @unique
  issuer       String     // mastercard | visa
  last4        String?
  status       String     // PENDING | ACTIVE | FROZEN | TERMINATED | FAILED
  balanceCents Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([userId])
}

model ConversionHistory {
  id              Int       @id @default(autoincrement())
  userId          Int
  fromCurrency    String
  toCurrency      String
  amount          Float
  rate            Float
  convertedAmount Float
  timestamp       DateTime  @default(now())
  user            TotalUser @relation(fields: [userId], references: [id])
}

model Admin {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  password    String
  firstName   String
  middleName  String
  lastName    String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  Transaction Transaction[]
  auditLogs   AuditLog[]
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  admin      Admin    @relation(fields: [adminId], references: [id])
  action     String
  targetType String?
  targetId   String?
  before     Json?
  after      Json?
  reason     String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      TotalUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpHash   String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  purpose OtpPurpose @default(PASSWORD)

  @@index([userId, createdAt])
}